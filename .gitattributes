# Fins de ligne : LF dans Git, quel que soit le poste.
# Cohérent avec la règle d'empreinte de l'ADR 0002 (content_hash normalisé en LF).
* text=auto eol=lf

# Scripts Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaires
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.db   binary
*.bat text eol=crlf
